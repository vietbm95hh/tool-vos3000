<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Vos3000Agent</AssemblyName>
    <RootNamespace>Vos3000Agent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>VOS3000 Agent Custom (C#)</AssemblyTitle>
    <Product>VOS3000 Agent Custom</Product>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);MockServer\**;ProxyCapture\**;DbProbe\**;Replayer\**;TestCustomer\**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Profile "portable": build 1 file .exe duy nhất, nhúng sẵn .NET runtime
    → máy đích KHÔNG cần cài .NET, KHÔNG cần file kèm.
    Lệnh:  dotnet publish -c Release -p:PublishProfile=Portable
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'ReleasePortable'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <!-- Logo GTINX CTS + icon app -->
  <ItemGroup>
    <Content Include="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Nhúng tài nguyên vào exe khi build portable (không cần mang theo thư mục Assets) -->
  <ItemGroup Condition="'$(Configuration)' == 'ReleasePortable'">
    <EmbeddedResource Include="Assets\logo.png" LogicalName="Vos3000Agent.Assets.logo.png" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="Vos3000Agent.Assets.app.ico" />
    <EmbeddedResource Include="Data\vos_session_capture.bin" LogicalName="Vos3000Agent.Data.vos_session_capture.bin" Condition="Exists('Data\vos_session_capture.bin')" />
    <EmbeddedResource Include="Data\vos_routing_c2s.bin" LogicalName="Vos3000Agent.Data.vos_routing_c2s.bin" Condition="Exists('Data\vos_routing_c2s.bin')" />
  </ItemGroup>


  <!-- Module protocol VOS3000 TCP 1202 (tái dùng VosProto/VosSession từ Replayer) -->
  <ItemGroup>
    <ProjectReference Include="Replayer\Replayer.csproj" />
  </ItemGroup>

  <!-- DB của tool (MySQL) — lưu log/nghiệp vụ/thống kê -->
  <ItemGroup>
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <!-- Template session capture dùng cho Mapping Prefix -->
  <ItemGroup>
    <None Include="Data\vos_session_capture.bin" CopyToOutputDirectory="PreserveNewest" />
    <!-- Traffic thật bắt qua proxy: template GET/SET call-in (InfoGatewayRouting) -->
    <None Include="Data\vos_routing_c2s.bin" CopyToOutputDirectory="PreserveNewest" Condition="Exists('Data\vos_routing_c2s.bin')" />
  </ItemGroup>

  <!-- WinExe đã nhúng runtimeconfig của chính nó; VosReplayer là thư viện nên bỏ file runtimeconfig thừa khi publish -->
  <Target Name="_RemoveReplayerRuntimeConfig" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'VosReplayer.runtimeconfig.json'" />
    </ItemGroup>
  </Target>

  <!--
    WinForms SDK KHÔNG tự tham chiếu UIAutomationClient / UIAutomationTypes.
    Target dưới đây dò gói đích Microsoft.WindowsDesktop.App.Ref (ưu tiên bản 8.x)
    rồi thêm 2 assembly Windows UI Automation trước khi biên dịch.
    KHÔNG xoá phần này, nếu không sẽ lỗi: 'System.Windows.Automation' không tồn tại.
  -->
  <Target Name="_AddUIAutomationReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_UIAutomationRef8 Include="$(NetCoreTargetingPackRoot)\Microsoft.WindowsDesktop.App.Ref\8.*\ref\net8.0\UIAutomationClient.dll" />
      <_UIAutomationRef9 Include="$(NetCoreTargetingPackRoot)\Microsoft.WindowsDesktop.App.Ref\9.*\ref\net9.0\UIAutomationClient.dll" />
    </ItemGroup>

    <PropertyGroup>
      <_UIAutomationDir>$([System.IO.Path]::GetDirectoryName(%(_UIAutomationRef8.Identity)))</_UIAutomationDir>
      <_UIAutomationDir Condition="'$(_UIAutomationDir)' == ''">$([System.IO.Path]::GetDirectoryName(%(_UIAutomationRef9.Identity)))</_UIAutomationDir>
    </PropertyGroup>

    <ItemGroup Condition="'$(_UIAutomationDir)' != '' and Exists('$(_UIAutomationDir)\UIAutomationTypes.dll')">
      <Reference Include="UIAutomationClient">
        <HintPath>$(_UIAutomationDir)\UIAutomationClient.dll</HintPath>
        <Private>false</Private>
      </Reference>
      <Reference Include="UIAutomationTypes">
        <HintPath>$(_UIAutomationDir)\UIAutomationTypes.dll</HintPath>
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

</Project>
